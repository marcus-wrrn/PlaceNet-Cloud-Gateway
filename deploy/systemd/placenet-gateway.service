# PlaceNet cloud gateway (native binary, orchestrated by systemd).
#
# Install: /etc/systemd/system/placenet-gateway.service  (deploy.sh does this)
# Manage:  sudo systemctl {enable --now,restart,stop,status} placenet-gateway
#
# The binary is built off-server and shipped by deploy.sh to /opt/placenet/bin.
# It writes mosquitto.conf, bootstraps the dynsec state, and spawns + supervises
# the Mosquitto broker as a child process — so this single unit owns the whole
# stack. Mosquitto must be installed on the host (mosquitto + mosquitto-clients).

[Unit]
Description=PlaceNet Cloud Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${REMOTE_USER}
WorkingDirectory=/opt/placenet
EnvironmentFile=/opt/placenet/.env
ExecStart=/opt/placenet/bin/placenet-cloud-gateway serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
