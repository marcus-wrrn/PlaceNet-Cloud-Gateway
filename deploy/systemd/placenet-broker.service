# PlaceNet Mosquitto broker (runs in Docker, orchestrated by systemd).
#
# Install: /etc/systemd/system/placenet-broker.service  (deploy.sh does this)
# Manage:  sudo systemctl {enable --now,restart,stop,status} placenet-broker
#
# Lifecycle is delegated to `docker compose` against /opt/placenet/docker-compose.yml.
# The compose `restart: unless-stopped` policy keeps the container alive between
# boots; this unit makes systemd the front door for up/down/restart.

[Unit]
Description=PlaceNet Mosquitto broker (Docker)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/placenet
# Secrets (DYNSEC_ADMIN_USER/PASSWORD) are read here by docker compose for
# variable interpolation in docker-compose.yml.
EnvironmentFile=/opt/placenet/.env
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose up -d --remove-orphans

[Install]
WantedBy=multi-user.target
