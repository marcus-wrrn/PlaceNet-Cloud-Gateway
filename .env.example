# PlaceNet cloud gateway — server environment.
#
# Copy to /opt/placenet/.env on the server and fill in the secrets. The gateway
# systemd unit loads this file via EnvironmentFile. The gateway spawns and
# supervises Mosquitto itself (no Docker), so this is the single source of truth
# for both the API and the embedded broker.
#
# Do NOT commit the real file (.env is gitignored).

# ── HTTPS login API (served natively by the gateway binary) ──
GATEWAY_API_HOST=0.0.0.0
GATEWAY_API_PORT=8443
GATEWAY_TLS_ENABLED=true
GATEWAY_TLS_CERT=/opt/placenet/certs/gateway/gateway.crt
GATEWAY_TLS_KEY=/opt/placenet/certs/gateway/gateway.key

# ── Credential / device store (created on first run; the dir must exist) ──
GATEWAY_DATABASE_URL=sqlite:///opt/placenet/data/placenet_gateway.db

# ── dynsec admin channel: gateway → embedded broker, loopback only ──
GATEWAY_MQTT_HOST=127.0.0.1
GATEWAY_MQTT_PORT=1883
DYNSEC_ADMIN_USER=gateway-admin
DYNSEC_ADMIN_PASSWORD=CHANGE_ME

# ── Embedded Mosquitto broker (spawned + supervised by the gateway) ──
# Binaries are looked up on PATH by default; override with absolute paths if
# mosquitto lives somewhere unusual.
MOSQUITTO_BINARY=mosquitto
MOSQUITTO_CTRL_BINARY=mosquitto_ctrl
# Path to the dynamic-security plugin shared object. The default is the Debian
# (apt) location; on other distros run `find / -name mosquitto_dynamic_security.so`.
MOSQUITTO_DYNSEC_PLUGIN=/usr/lib/x86_64-linux-gnu/mosquitto_dynamic_security.so
# Generated mosquitto.conf lives here; broker persistence + dynamic-security.json
# live in the data dir. Both are created on startup if absent.
GATEWAY_CONFIG_DIR=/opt/placenet/config
GATEWAY_DATA_DIR=/opt/placenet/data
# Broker TLS cert/key for the public MQTTS listener (publicly-trusted certs).
GATEWAY_BROKER_CERT=/opt/placenet/certs/broker/server.crt
GATEWAY_BROKER_KEY=/opt/placenet/certs/broker/server.key
# Port the broker's public MQTTS listener binds to.
GATEWAY_BROKER_MQTTS_PORT=8883

# ── Public MQTTS coordinates handed back to Hamlets in the login response ──
GATEWAY_BROKER_PUBLIC_HOST=gateway.example.com
GATEWAY_BROKER_PUBLIC_PORT=8883
