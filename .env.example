# PlaceNet cloud gateway — server environment.
#
# Copy to /opt/placenet/.env on the server and fill in the secrets. This single
# file is the source of truth for BOTH:
#   * docker compose (broker) — reads DYNSEC_ADMIN_* for interpolation
#   * the gateway systemd unit  — loaded via EnvironmentFile
#
# Do NOT commit the real file (.env is gitignored).

# ── HTTPS login API (served natively by the gateway binary) ──
GATEWAY_API_HOST=0.0.0.0
GATEWAY_API_PORT=8443
GATEWAY_TLS_ENABLED=true
GATEWAY_TLS_CERT=/opt/placenet/certs/gateway/gateway.crt
GATEWAY_TLS_KEY=/opt/placenet/certs/gateway/gateway.key

# ── Credential / device store (created on first run; the dir must exist) ──
GATEWAY_DATABASE_URL=sqlite:///opt/placenet/data/placenet_gateway.db

# ── dynsec admin channel: gateway (host) → broker (Docker), loopback only ──
GATEWAY_MQTT_HOST=127.0.0.1
GATEWAY_MQTT_PORT=1883
DYNSEC_ADMIN_USER=gateway-admin
DYNSEC_ADMIN_PASSWORD=CHANGE_ME

# ── Public MQTTS coordinates handed back to Hamlets in the login response ──
GATEWAY_BROKER_PUBLIC_HOST=gateway.example.com
GATEWAY_BROKER_PUBLIC_PORT=8883
